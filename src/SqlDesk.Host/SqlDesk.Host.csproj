<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Um único .exe: runtime e bibliotecas nativas embutidos e comprimidos, sem símbolos nem arquivos de idioma extras. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>SqlDesk</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>SqlLite Studio</AssemblyTitle>
    <Product>SqlLite Studio</Product>
    <Version>1.0.0</Version>
    <WebDir>$(MSBuildProjectDirectory)\..\SqlDesk.Web</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlDesk.Core\SqlDesk.Core.csproj" />
    <ProjectReference Include="..\SqlDesk.SqlAnalysis\SqlDesk.SqlAnalysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- Na pasta de publicação fica só o SqlDesk.exe: tira símbolos e documentação XML das dependências. -->
  <Target Name="CleanPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <ExtraPublishFile Include="$(PublishDir)*.pdb;$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(ExtraPublishFile)" />
  </Target>

  <!-- Release: compila o frontend e embute dist/ como recursos (extraídos em runtime e servidos via virtual host). -->
  <Target Name="BuildWeb" BeforeTargets="AssignTargetPaths" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
    <ItemGroup>
      <WebFile Include="$(WebDir)\dist\**\*" />
      <EmbeddedResource Include="@(WebFile)" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
