<Window x:Class="SqlDesk.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SqlLite Studio" Icon="Assets/app.ico" Height="800" Width="1280" MinHeight="480" MinWidth="720"
        WindowStyle="None" AllowsTransparency="False" Background="#151515"
        WindowStartupLocation="CenterScreen">
    <!-- A barra de título é desenhada pelo frontend (regiões app-region: drag). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#151515" />
    </Grid>
</Window>
